{
  "version": 2,
  "builds": [
    { "src": "api/main.py", "use": "@vercel/python" },
    { "src": "index.html", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/listen", "dest": "api/main.py" },
    { "src": "/api/think", "dest": "api/main.py" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
